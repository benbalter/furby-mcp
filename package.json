{
  "name": "furby-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling Furby Connect via Bluetooth using bluefluff",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "furby-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "furby",
    "bluetooth",
    "bluefluff",
    "model-context-protocol"
  ],
  "author": "Ben Balter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbalter/furby-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/benbalter/furby-mcp/issues"
  },
  "homepage": "https://github.com/benbalter/furby-mcp#readme",
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "winston": "^3.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
